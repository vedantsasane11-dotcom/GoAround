# GoAround - Environment Variables Template
# Copy this file to .env and provide your project-specific keys.
# DO NOT commit real secrets or credentials to source control.

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
